{
  "name": "aether-browser",
  "version": "1.1.0",
  "productName": "ÆTHER",
  "description": "Local AI-powered engine and knowledge hub",
  "keywords": [
    "knowledge",
    "ai",
    "local",
    "research",
    "privacy",
    "rag"
  ],
  "author": "canpixel.com",
  "homepage": "https://canpixel.com",
  "license": "PolyForm-Strict-1.0.0",
  "scripts": {
    "format": "prettier --write .",
    "lint": "eslint --cache .",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck:tauri": "cargo check --manifest-path src-tauri/Cargo.toml",
    "typecheck": "bun run typecheck:web && bun run typecheck:tauri",
    "test": "cargo test --manifest-path src-tauri/Cargo.toml --lib",
    "check:platforms": "bash scripts/check-platforms.sh",
    "version:bump": "bun scripts/bump-version.ts",
    "version:check": "bun scripts/bump-version.ts --check",
    "release": "bun scripts/release.ts",
    "start": "tauri dev",
    "dev": "tauri dev",
    "dev:vite": "vite",
    "build:vite": "vite build",
    "prepare:dmg-background": "bash scripts/prepare-dmg-background.sh",
    "build": "bun run typecheck && tauri build --bundles app && bun run dmg",
    "dmg": "bash scripts/make-styled-dmg.sh",
    "android:init": "bash scripts/android.sh init",
    "android:dev": "bash scripts/android.sh dev",
    "android:build": "bash scripts/android.sh build",
    "android:build:apk": "bash scripts/android.sh build --apk",
    "android:build:aab": "bash scripts/android.sh build --aab",
    "linux:arm64:build": "bash scripts/build-linux.sh",
    "linux:arm64:export": "bash scripts/build-linux.sh",
    "linux:arm64:deb": "LINUX_BUNDLES=deb bash scripts/build-linux.sh",
    "linux:x64:build": "LINUX_DOCKER_PLATFORM=linux/amd64 LINUX_TARGET=x86_64-unknown-linux-gnu LINUX_ARCH_SLUG=x64 bash scripts/build-linux.sh",
    "linux:x64:deb": "LINUX_DOCKER_PLATFORM=linux/amd64 LINUX_TARGET=x86_64-unknown-linux-gnu LINUX_ARCH_SLUG=x64 LINUX_BUNDLES=deb bash scripts/build-linux.sh",
    "build:desktop-local": "bun run build && bun run linux:arm64:build && bun run linux:x64:build",
    "tauri": "tauri"
  },
  "overrides": {
    "brace-expansion": "^5.0.7",
    "@babel/core": "^7.29.1"
  },
  "dependencies": {
    "ldrs": "^1.1.9",
    "lucide-react": "^1.26.0"
  },
  "devDependencies": {
    "@babel/core": "^8.0.1",
    "brace-expansion": "^5.0.8",
    "@eslint/js": "^9.39.5",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/cli": "^2.11.4",
    "@types/bun": "^1.3.14",
    "@types/node": "^25.9.5",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "appdmg": "^0.6.6",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "prettier": "^3.9.6",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.1.5"
  }
}
